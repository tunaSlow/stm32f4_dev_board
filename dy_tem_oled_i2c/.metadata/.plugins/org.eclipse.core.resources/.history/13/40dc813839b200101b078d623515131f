   RELAY_1(1);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   RELAY_2(0);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   LED_ALL(0x03);//LED1~4整组操作函数（低4位的1/0状态对应4个LED亮灭，最低位对应LED1）
   HAL_Delay(800);//延时
   RELAY_1(0);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   RELAY_2(1);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   LED_ALL(0x07);//LED1~4整组操作函数（低4位的1/0状态对应4个LED亮灭，最低位对应LED1）
   HAL_Delay(800);//延时
   RELAY_1(0);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   RELAY_2(0);//继电器的控制程序（c=0继电器放开，c=1继电器吸合）
   LED_ALL(0x0F);//LED1~4整组操作函数（低4位的1/0状态对应4个LED亮灭，最低位对应LED1）
   LM75A_GetTemp(buffer); //读取LM75A的温度数据
   MENU=0;//初始菜单值
   a=0;//使计数清0
   USB_MARK=1;//U盘状态标志位
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
//菜单0（EX）LCD测试（不连接LCD模块时不运行此菜单）
	  if(MENU==0){//菜单0：LCD彩色触摸屏测试
	   //LCD和触摸屏初始化与显示部分
	 	if(LCD_Init()){//LCD彩屏和触摸屏初始化（返回值1：初始化成功，0：初始化失败）
			LCD_CLEAR(Red);//LCD彩屏清除内容（变成单色背景）
			LCD_CLEAR(Green);//LCD彩屏清除内容（变成单色背景）
			LCD_CLEAR(Blue);//LCD彩屏清除内容（变成单色背景）
			ForeColor=White;//设置字体的颜色（在使用LCD_printf_ASCII函数之前设置）
			LCD_DISPLAY_BMP_YoungTalkLogo(480,130);//在指定坐标显示洋桃电子LOGO
			LCD_printf_ASCII(1,8,32,"-YoungTalk No.2-  www.doyoung.net"); //在LCD上显示字符串
			LCD_printf_CHS(0,0,16,"洋桃电子");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
			LCD_printf_CHS(1,0,24,"洋桃电子");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
			LCD_printf_CHS(1,0,48,"洋桃");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
			LCD_printf_CHS(2,0,48,"电子");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
			LCD_printf_ASCII(4,10,32,"LCD ID:%x",LCD_ID); //在LCD上显示字符串
			LCD_printf_ASCII(8,2,48,"LCD TEST OK!   "); //在LCD上显示字符串
			USART1_printf("\n\r【EX】LCD初始化成功！观察LCD屏上是否有正常的英文显示（LCD ID:%x）。\n\r",LCD_ID); //串口发送标题
			OLED_printf_0816_ASCII(10,0,"TESTEX:LCD TOUCH"); //显示字符串
			OLED_printf_0816_ASCII(2,0,"[KEY4] to next! "); //显示字符串
			OLED_printf_0816_ASCII(4,0,"LCD TEST OK!    "); //显示字符串
			OLED_printf_0816_ASCII(6,0,"TOUCH TEST ?    "); //显示字符串
			MENU=1;//初始菜单值（如有LCD连接才进入LCD测试程序）
	 	}else{
	 		USART1_printf("LCD初始化失败！LCD彩屏未连接或驱动芯片不是NT35510/RM68120/OTM8009A（LCD ID:%x）。\n\r",LCD_ID); //串口发送标题
	 	    MENU=5;//没有LCD时跳到下一个测试
	 	}
	 	if(TOUCH_Init()){//触摸屏初始化（返回0失败，1成功）
	 		TOUCH_Read(Landscape);//循环读取触摸屏当前状态和触发坐标（参数是横竖屏方向）
	 		TOUCH_STA=0;//标志位清0
			LCD_printf_ASCII(5,10,32,"TOUCH_ID:%s  ",TOUCH_ID); //在LCD上显示字符串
			LCD_printf_CHS(6,5,32,"点击屏幕完成测试");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
			USART1_printf("\n\r【EX】触摸屏初始化成功！（TOUCH ID:%s）。\n\r",TOUCH_ID); //串口发送标题
			USART1_printf("【EX】LCD彩色触摸屏测试：手指按住屏幕时坐标值会改变，最多5点触发（按【KEY4】到下一项）。\n\r");//串口发送标题
			BUZZER_SOLO2();//提示音
	 	}else{
	 		LCD_printf_ASCII(4,8,32,"NO TOUCH IC(ID:%s) %x ",TOUCH_ID,TOUCH_STA); //在LCD上显示字符串
	 		USART1_printf("触摸屏初始化失败！LCD彩屏未连接或驱动芯片不是GT9147或GT911（TOUCH ID:%s）。\n\r",TOUCH_ID); //串口发送标题
	 	}
	  }
	  if(MENU==1){//菜单1：LCD彩色触摸屏测试
		TOUCH_Read(Landscape);//循环读取触摸屏当前状态和触发坐标（参数是横竖屏方向）
		if(TOUCH_STA&0x90){//判断有没有触摸屏触发（可在屏幕上连续触摸画图）
			LCD_Vector_Circle(TOUCH_X[0],TOUCH_Y[0],10);//绘制矢量正圆形（参数：圆心X坐标，圆心Y坐标，半径）
			if((TOUCH_STA&0x0F)>0 && a==0){//判断当有大于0个触摸点，则触摸测试成功
				LCD_printf_ASCII(9,10,32,"[KEY4] to next!  "); //在LCD上显示字符串
				LCD_printf_CHS(7,5,32,"屏幕测试完成");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
				LCD_printf_ASCII(8,16,48,"TOUCH TEST OK!"); //在LCD上显示字符串
				OLED_printf_0816_ASCII(6,0,"TOUCH TEST OK!  "); //显示字符串
				USART1_printf("【EX】LCD和触摸测试完成！\n\r"); //串口发送标题
				BUZZER_SOLO2();//提示音
				a=1;//不要刷新本判断
			}
		}
		TOUCH_STA=0;//标志位清0
		if(KEY_4()){//按KEY4进入下一项测试
			BUZZER_SOLO2();//提示音
			LCD_OFF();//退出LCD测试时关闭LCD屏
			MENU=5;//跳到下一个测试菜单
		}
	  }
//菜单5
	  if(MENU==5){//菜单5：时间温度测试
		USART1_printf("\n\r【4】RTC和LM75A测试：观察时间、温度值是否正常刷新/走时。\n\r"); //串口发送标题
		OLED_printf_0816_ASCII(10,0,"TEST2:RTC&LM75A "); //显示字符串
		OLED_printf_0816_ASCII(2,0,"[KEY1] to next! "); //显示字符串
		OLED_printf_0816_ASCII(4,0,"Time:           "); //显示字符串
		OLED_printf_0816_ASCII(6,0,"Temp:           "); //显示字符串
		MENU=6;//时间温度显示刷新
	  }
	  if(MENU==6){//菜单6：时间温度显示刷新
		HAL_Delay(100);//刷新延时
		//切换菜单操作
		if(USART1_RX_STA&0xC000){//在超级终端中按回车键设置时钟
			BUZZER_SOLO2();//提示音
			MENU=7; //串口1接收到回车键进入设置时间菜单。
		}
		if(KEY_1()){//按KEY1进入下一项测试
			BUZZER_SOLO2();//提示音
			MENU=10;//退出设置时间功能
		}
		//读取时间和温度函数
		LM75A_GetTemp(buffer); //读取LM75A的温度数据
		HAL_RTC_GetTime(&hrtc, &RtcTime,  RTC_FORMAT_BIN);//读出时间值
		HAL_RTC_GetDate(&hrtc, &RtcDate,  RTC_FORMAT_BIN);//一定要先读时间后读日期
		//USART1串口显示：时间和温度值刷新
		USART1_printf(" 实时时间：%04d-%02d-%02d %02d:%02d:%02d ",2000+RtcDate.Year,  RtcDate.Month, RtcDate.Date,RtcTime.Hours,  RtcTime.Minutes, RtcTime.Seconds);//显示日期时间
		if(buffer[0])USART1_printf("温度：-%d.%d℃",buffer[1],buffer[2]); //判断是负数温度时串口显示温度值
				else USART1_printf("温度：%d.%d℃",buffer[1],buffer[2]);  //正数温度时串口显示温度值
		USART1_printf("（回车键设置时间，按【KEY1】到下一项）\r");//只用/r可在本行刷新数据，不另起一行
		//OLED屏显示：时分秒和温度
		OLED_printf_0816_ASCII(4,0,"Time: %02d:%02d:%02d  ",RtcTime.Hours,RtcTime.Minutes,RtcTime.Seconds); //显示时分秒
		if(buffer[0])OLED_printf_0816_ASCII(6,0,"Temp:-%d.%02dc   ",buffer[1],buffer[2]); //显示带负数温度
		else OLED_printf_0816_ASCII(6,0,"Temp: %d.%02dc   ",buffer[1],buffer[2]); //显示正数温度
	  }
//菜单7
	  if(MENU==7){	//设置时间界面
		if(USART1_RX_STA&0xC000){ //如果标志位是0xC000表示收到数据串完成，可以处理。
		   if((USART1_RX_STA&0x3FFF)==0){ //单独的回车键再显示一次欢迎词
			   HAL_RTC_GetTime(&hrtc, &RtcTime,  RTC_FORMAT_BIN);//读出时间值
			   HAL_RTC_GetDate(&hrtc, &RtcDate,  RTC_FORMAT_BIN);//一定要先读时间后读日期
			   USART1_printf(" 实时时间：%04d-%02d-%02d %02d:%02d:%02d \r\n",2000+RtcDate.Year,  RtcDate.Month, RtcDate.Date,RtcTime.Hours,  RtcTime.Minutes, RtcTime.Seconds);//显示日期时间
			   USART1_printf(" 设置时间：格式为4位年2位月日时分秒（例：20220806120000），按回车键确定！\r\n");
		   }else  if((USART1_RX_STA&0x3FFF)==14){ //判断数据是不是14个
			   //将超级终端发过来的数据换算并写入RTC
			   RtcDate.Year =  (USART1_RX_BUF[2]-0x30)*10+USART1_RX_BUF[3]-0x30;
			   RtcDate.Month =  (USART1_RX_BUF[4]-0x30)*10+USART1_RX_BUF[5]-0x30;//串口发来的是字符，减0x30后才能得到十进制0~9的数据
			   RtcDate.Date =  (USART1_RX_BUF[6]-0x30)*10+USART1_RX_BUF[7]-0x30;
			   RtcTime.Hours =  (USART1_RX_BUF[8]-0x30)*10+USART1_RX_BUF[9]-0x30;
			   RtcTime.Minutes =  (USART1_RX_BUF[10]-0x30)*10+USART1_RX_BUF[11]-0x30;
			   RtcTime.Seconds =  (USART1_RX_BUF[12]-0x30)*10+USART1_RX_BUF[13]-0x30;
