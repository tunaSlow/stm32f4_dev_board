   USART1_printf("STM32F407本芯片ID: %08X %08X %08X FLAH容量：%dKB \r\n",id[0],id[1],id[2],a); //从串口输出16进制96位ID码

   a = HAL_RNG_GetRandomNumber(&hrng);//读出一个硬件随时数
   USART1_printf("随时数生成器RNG值：%08X ",a); //从串口输出

