   id[1] = *(__IO uint32_t *)(0x1FFF7A14); //
   id[2] = *(__IO uint32_t *)(0x1FFF7A18); //（低字节）
   a   = *(__IO uint16_t *)(0x1FFF7A22); //读出本芯片的FLASH容量
