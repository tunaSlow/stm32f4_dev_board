   OLED_printf_0816_ASCII(15,43,"2"); //显示字符串
   OLED_printf_1616_CHS(15,51,"号开发板");//显示汉字串（不能使用转译字符）（参数：行，列，汉字串）
   //开启串口中断
   HAL_UART_Receive_IT(&huart1,(uint8_t *)&USART1_NewData,1);//开启串口1接收中断
   HAL_UART_Receive_IT(&huart2,(uint8_t *)&USART2_NewData,1); //开启串口2接收中断
   MENU=1;//初始菜单值（默认1）
   //【1】串口发送测试
