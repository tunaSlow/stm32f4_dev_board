/* lv_port_disp.c */
#include "../../Middlewares/Third_Party/lvgl/lvgl.h"
#include "lcd.h"        /* your driver header with LCD_Write_Cursor, SET_GRAM, etc. */
#include "main.h"       /* for hsram1, LCD_DAT symbols if needed */

#define LCD_H_RES   800
#define LCD_V_RES   480

static lv_disp_draw_buf_t s_draw_buf;
static lv_color_t s_buf1[LCD_H_RES * 2];   /* 2 lines */
static lv_color_t s_buf2[LCD_H_RES * 2];

static void lcd_flush_cb(lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p);

void lv_port_disp_init(void)
{
    lv_disp_draw_buf_init(&s_draw_buf, s_buf1, s_buf2, LCD_H_RES * 2);

    lv_disp_drv_t dd;
    lv_disp_drv_init(&dd);
    dd.hor_res = LCD_H_RES;
    dd.ver_res = LCD_V_RES;
    dd.flush_cb = lcd_flush_cb;
    dd.draw_buf = &s_draw_buf;
    dd.color_format = LV_COLOR_FORMAT_RGB565;
    lv_disp_drv_register(&dd);
}

/* Optimized row streaming flush */
static void lcd_flush_cb(lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p)
{
    uint16_t x1 = (uint16_t)area->x1;
    uint16_t y1 = (uint16_t)area->y1;
    uint16_t x2 = (uint16_t)area->x2;
    uint16_t y2 = (uint16_t)area->y2;

    /* Clip (LVGL already clips but guard anyway) */
    if(x2 < x1 || y2 < y1) {
        lv_disp_flush_ready(disp);
        return;
    }

    uint16_t width  = x2 - x1 + 1;
    for(uint16_t y = y1; y <= y2; y++)
    {
        /* Set cursor to start of row (controller supports streaming) */
        LCD_Write_Cursor(x1, y);          /* positions address */
        LCD_Write_COM(SET_GRAM);          /* begin GRAM write */

        /* Stream one full row in RGB565 */
        /* color_p points to consecutive lv_color_t (16-bit) */
        for(uint16_t i = 0; i < width; i++) {
            uint16_t c = color_p[i].full;
            HAL_SRAM_Write_16b(&hsram1, LCD_DAT, &c, 1);
        }
        color_p += width;
    }

    lv_disp_flush_ready(disp);
}
