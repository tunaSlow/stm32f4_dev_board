static inline lv_coord_t clamp(int v, int lo, int hi) {
    return (v < lo) ? lo : (v > hi ? hi : v);
}

static void touch_cb(lv_indev_t * indev, lv_indev_data_t * data)
{
    /* Always poll the controller; don't rely on EXTI flags */
    TOUCH_Read(Landscape);   // keep consistent with LCD orientation

    static lv_coord_t last_x = 0, last_y = 0;
    bool pressed = false;

    if(TOUCH_STA & 0x90) {                 // data updated + (pressed or released)
        if((TOUCH_STA & 0x0F) >= 1) {      // at least 1 contact
            last_x = clamp(TOUCH_X[0], 0, 799);
            last_y = clamp(TOUCH_Y[0], 0, 479);
            pressed = true;
        }
        TOUCH_STA = 0;                     // clear for next cycle
    }

    data->state   = pressed ? LV_INDEV_STATE_PRESSED : LV_INDEV_STATE_RELEASED;
    data->point.x = last_x;
    data->point.y = last_y;
}
