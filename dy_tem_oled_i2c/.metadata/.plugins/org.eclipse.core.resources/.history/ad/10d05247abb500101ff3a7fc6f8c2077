/**
 * touch_driver.c
 * Generic GT911/FT5x06-like I2C touch driver for LVGL v9 port.
 * - Uses I2C2 (STM32 HAL)
 * - INT on PG13 (falling edge, EXTI)
 * - RESET on PG15 (optional)
 * - Updates LVGL via weak functions declared in lvgl_port_indev.c:
 *     void touch_port_set_point(uint16_t x, uint16_t y);
 *     void touch_port_set_pressed(bool down);
 */

#include "touch_driver.h"
#include "lvgl.h"
#include <string.h>
#include <stdio.h>
#include "stm32f4xx_hal.h"   // or your STM32 HAL header

/* ========= Link to Step 2 weak hooks ========= */
void touch_port_set_point(uint16_t x, uint16_t y);
void touch_port_set_pressed(bool down);

/* ========= Hardware config (adjust as needed) ========= */
#define TP_I2C                 hi2c2              // CubeMX-generated handle
extern I2C_HandleTypeDef      TP_I2C;

#define TP_INT_GPIO_Port       GPIOG
#define TP_INT_Pin             GPIO_PIN_13
#define TP_RST_GPIO_Port       GPIOG
#define TP_RST_Pin             GPIO_PIN_15

/* Choose your IC here (uncomment the one you use) */
// #define TP_CHIP_GT911
#define TP_CHIP_FT5X06

/* ---- GT911 addresses & registers ---- */
#ifdef TP_CHIP_GT911
#define TP_I2C_ADDR            (0x5D << 1)       // Or 0x14<<1 depending on AD pin
#define TP_REG_STATUS          0x814E
#define TP_REG_FIRST_POINT     0x8150            // P1
#define TP_REG_CFG_START       0x8047
#define TP_MAX_POINTS          5
#endif

/* ---- FT5x06 addresses & registers ---- */
#ifdef TP_CHIP_FT5X06
#define TP_I2C_ADDR            (0x38 << 1)
#define TP_REG_STATUS          0x02              // [3:0] = number of points
#define TP_REG_FIRST_POINT     0x03              // P1: XH, XL, YH, YL, ID, ...
#define TP_MAX_POINTS          5
#endif

/* ========= Internal state ========= */
static volatile bool s_irq_flag = false;

static struct {
    uint16_t disp_w, disp_h;
    // Raw caps max range (typical controller reports raw in its native range)
    uint16_t raw_max_x, raw_max_y;

    // Mapping options
    bool swap_xy;
    bool invert_x;
    bool invert_y;
    uint8_t rot90;   // 0, 1, 2, 3 (multiples of 90°), if you prefer rotation param
} cfg = {
    .disp_w = 800, .disp_h = 480,
    .raw_max_x = 800, .raw_max_y = 480,
    .swap_xy = false, .invert_x = false, .invert_y = false, .rot90 = 0
};

/* ========= Utilities ========= */
static inline uint16_t u16_clamp(int v, int lo, int hi)
{
    if(v < lo) return (uint16_t)lo;
    if(v > hi) return (uint16_t)hi;
    return (uint16_t)v;
}

static void map_raw_to_disp(uint16_t rx, uint16_t ry, uint16_t *dx, uint16_t *dy)
{
    /* Normalize raw → [0..raw_max-1], then scale to display size.
       Many GT/FT controllers already report 0..(max-1); keep as-is unless you calibrate. */

    int x = rx;
    int y = ry;

    // Optional axis swap first
    if(cfg.swap_xy) {
        int t = x; x = y; y = t;
        uint16_t tmax = cfg.raw_max_x; cfg.raw_max_x = cfg.raw_max_y; cfg.raw_max_y = tmax; // one-time swap suggestion
    }

    // Optional inversion
    if(cfg.invert_x) x = (int)(cfg.raw_max_x - 1) - x;
    if(cfg.invert_y) y = (int)(cfg.raw_max_y - 1) - y;

    // Handle rotation in 90° steps (if used)
    if(cfg.rot90 == 1) {            // 90°
        int nx = y;
        int ny = (int)(cfg.raw_max_x - 1) - x;
        x = nx; y = ny;
        // swap target size for 90°/270°
        uint16_t tw = cfg.disp_w; cfg.disp_w = cfg.disp_h; cfg.disp_h = tw; // one-time swap suggestion
    } else if(cfg.rot90 == 2) {     // 180°
        x = (int)(cfg.raw_max_x - 1) - x;
        y = (int)(cfg.raw_max_y - 1) - y;
    } else if(cfg.rot90 == 3) {     // 270°
        int nx = (int)(cfg.raw_max_y - 1) - y;
        int ny = x;
        x = nx; y = ny;
        uint16_t tw = cfg.disp_w; cfg.disp_w = cfg.disp_h; cfg.disp_h = tw; // one-time swap suggestion
    }

    // Scale to display if raw range differs; here we assume equal ranges
    // For different ranges: x = x * (cfg.disp_w - 1) / (cfg.raw_max_x - 1), etc.

    *dx = u16_clamp(x, 0, (int)cfg.disp_w - 1);
    *dy = u16_clamp(y, 0, (int)cfg.disp_h - 1);
}

/* ========= Low-level I2C helpers ========= */
static HAL_StatusTypeDef tp_write_reg16(uint16_t reg, const uint8_t *data, uint16_t len)
{
#ifdef TP_CHIP_GT911
    // 16-bit register address (big-endian)
    uint8_t buf[2 + 8]; // enough for small writes
    if(len > 8) return HAL_ERROR;
    buf[0] = (uint8_t)(reg >> 8);
    buf[1] = (uint8_t)(reg & 0xFF);
    memcpy(&buf[2], data, len);
    return HAL_I2C_Master_Transmit(&TP_I2C, TP_I2C_ADDR, buf, (uint16_t)(2 + len), 10);
#else
    (void)reg; (void)data; (void)len;
    return HAL_ERROR;
#endif
}

static HAL_StatusTypeDef tp_read_reg16(uint16_t reg, uint8_t *data, uint16_t len)
{
#ifdef TP_CHIP_GT911
    uint8_t reg_be[2] = { (uint8_t)(reg >> 8), (uint8_t)(reg & 0xFF) };
    HAL_StatusTypeDef st = HAL_I2C_Master_Transmit(&TP_I2C, TP_I2C_ADDR, reg_be, 2, 10);
    if(st != HAL_OK) return st;
    return HAL_I2C_Master_Receive(&TP_I2C, TP_I2C_ADDR, data, len, 10);
#else
    (void)reg; (void)data; (void)len;
    return HAL_ERROR;
#endif
}

static HAL_StatusTypeDef tp_read_reg8(uint8_t reg, uint8_t *data, uint16_t len)
{
#ifdef TP_CHIP_FT5X06
    HAL_StatusTypeDef st = HAL_I2C_Master_Transmit(&TP_I2C, TP_I2C_ADDR, &reg, 1, 10);
    if(st != HAL_OK) return st;
    return HAL_I2C_Master_Receive(&TP_I2C, TP_I2C_ADDR, data, len, 10);
#else
    (void)reg; (void)data; (void)len;
    return HAL_ERROR;
#endif
}

/* ========= IRQ handling ========= */
void EXTI15_10_IRQHandler(void)
{
    if(__HAL_GPIO_EXTI_GET_IT(TP_INT_Pin) != RESET) {
        __HAL_GPIO_EXTI_CLEAR_IT(TP_INT_Pin);
        s_irq_flag = true;
    }
}

/* ========= Chip-specific init & read ========= */
static void tp_reset_seq(void)
{
    // If RESET pin is connected
    HAL_GPIO_WritePin(TP_RST_GPIO_Port, TP_RST_Pin, GPIO_PIN_RESET);
    HAL_Delay(10);
    HAL_GPIO_WritePin(TP_RST_GPIO_Port, TP_RST_Pin, GPIO_PIN_SET);
    HAL_Delay(50);
}

static bool tp_read_first_point(uint16_t *rx, uint16_t *ry, bool *pressed)
{
#ifdef TP_CHIP_GT911
    /* Read status: bit7 = data ready, low 4 bits = number of points */
    uint8_t status = 0;
    if(tp_read_reg16(TP_REG_STATUS, &status, 1) != HAL_OK) return false;

    uint8_t n = status & 0x0F;
    bool have = (n > 0);
    *pressed = have;

    if(have) {
        uint8_t buf[4];
        if(tp_read_reg16(TP_REG_FIRST_POINT, buf, 4) != HAL_OK) return false;
        // GT911: X = buf0 | buf1<<8, Y = buf2 | buf3<<8 (little-endian)
        *rx = (uint16_t)(buf[0] | (buf[1] << 8));
        *ry = (uint16_t)(buf[2] | (buf[3] << 8));
    }

    // Clear status to ack
    uint8_t zero = 0;
    tp_write_reg16(TP_REG_STATUS, &zero, 1);

    return true;
#endif

#ifdef TP_CHIP_FT5X06
    uint8_t status = 0;
    if(tp_read_reg8(TP_REG_STATUS, &status, 1) != HAL_OK) return false;
    uint8_t n = status & 0x0F;
    bool have = (n > 0);
    *pressed = have;

    if(have) {
        uint8_t buf[4];
        // FT5x06 P1: XH, XL, YH, YL (bits: XH[3:0] X11..8, YH[3:0] Y11..8)
        if(tp_read_reg8(TP_REG_FIRST_POINT, buf, 4) != HAL_OK) return false;

        uint16_t x = (((uint16_t)(buf[0] & 0x0F)) << 8) | buf[1];
        uint16_t y = (((uint16_t)(buf[2] & 0x0F)) << 8) | buf[3];
        *rx = x; *ry = y;
    }
    return true;
#endif
    return false;
}

/* ========= Public API ========= */
void touch_driver_init(uint16_t disp_w, uint16_t disp_h,
                       bool swap_xy, bool invert_x, bool invert_y, uint8_t rotation90)
{
    cfg.disp_w = disp_w;
    cfg.disp_h = disp_h;
    cfg.swap_xy = swap_xy;
    cfg.invert_x = invert_x;
    cfg.invert_y = invert_y;
    cfg.rot90 = rotation90 % 4;

    /* If your controller reports a fixed raw max (e.g., 800x480), set here */
#ifdef TP_CHIP_GT911
    cfg.raw_max_x = 800; cfg.raw_max_y = 480; // adjust if different in your panel cfg
#endif
#ifdef TP_CHIP_FT5X06
    cfg.raw_max_x = 800; cfg.raw_max_y = 480; // common modules; verify via datasheet
#endif
    // GPIO and I2C2 are expected to be initialized by CubeMX before calling this.
    // Configure INT pin EXTI (falling-edge). CubeMX usually generates this too.

    tp_reset_seq();

#ifdef TP_CHIP_GT911
    // Optional: read config/version or write configuration table here if needed.
    // uint8_t cfg_ver; tp_read_reg16(TP_REG_CFG_START, &cfg_ver, 1);
#endif

    // Clear any pending IRQ noise
    s_irq_flag = true; // force one poll to sync state
}

void touch_driver_set_display_size(uint16_t w, uint16_t h)
{
    cfg.disp_w = w;
    cfg.disp_h = h;
}

/* Call this frequently (e.g., in the main loop). It returns quickly unless IRQ fired. */
void touch_driver_poll(void)
{
    if(!s_irq_flag) return;
    s_irq_flag = false;

    uint16_t rx=0, ry=0;
    bool pressed=false;

    if(!tp_read_first_point(&rx, &ry, &pressed)) {
        // If read failed, keep previous state or report UP
        touch_port_set_pressed(false);
        return;
    }

    if(pressed) {
        uint16_t dx=0, dy=0;
        map_raw_to_disp(rx, ry, &dx, &dy);
        touch_port_set_point(dx, dy);
        touch_port_set_pressed(true);
    } else {
        touch_port_set_pressed(false);
    }
}
